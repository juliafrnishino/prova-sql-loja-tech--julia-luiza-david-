/***2.1 (filtros combinados)** Listem código, nome, cidade e data de nascimento dos clientes do estado **SP**, nascidos **entre 01/01/1980 e 31/12/1988**, cujo nome **começa com "M" ou com "P"**. Ordenem por nome. *(Cuidado com a precedência entre `AND` e `OR`.)*/
 
 select código, nome, cidade, DataNascimento from clientes where UF = 'SP' and DataNascimento = '1980-01-01' between '1988-12-31' and nome = 'M%' or 'P%' order by nome;
 
 /***2.2 (valores nulos)** Listem todos os clientes mostrando `'SEM E-MAIL'` quando o e-mail for nulo e `'SEM CEP'` quando o CEP for nulo.
 */
 
 select nome, ifnull(Email, 'SEM E-MAIL'),ifnull(cidade, 'SEM CEP') from clientes;
 
 /***2.3 (INNER JOIN)** Relatório de vendas detalhado: nome do cliente, descrição do produto, data da venda, quantidade, valor unitário praticado e **total do item** (`Quantidade × ValorVenda`), da venda mais recente para a mais antiga.*/
 
select 
	c.nome, 
    p.decricao,
    v.data_venda,
    v.quantidade,
    v.ValorVenda,
    v.quantidade * v.ValorVenda as total_do_item
from vendas as v
    inner join clientes as c on c.codigo = v.fkVendasClientes
    inner join produtos as p on p.codigo = v.fkVendasProdutos
    order by data_venda;
    
/***2.4 (LEFT JOIN)** Quais clientes **nunca compraram**? Mostrem código e nome.*/
 
select 
	c.codigo,
	c.nome, 
    v.data_venda,
    v.ValorVenda
from vendas as v
    left join clientes as c on v.fkVendasClientes = c.codigo
    where v.fkVendasClientes = null;
 
 /*2.5 (RIGHT JOIN)** Quais produtos **nunca foram vendidos**? Resolvam **obrigatoriamente com `RIGHT JOIN`*/
 
select 
    p.decricao,
    v.data_venda,
    v.quantidade,
    v.ValorVenda,
    v.quantidade * v.ValorVenda as total_do_item
from vendas as v
    right join produtos as p on p.codigo = v.fkVendasProdutos
    order by data_venda;

